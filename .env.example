# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public. Used to build absolute links in outgoing auth emails (password
# reset) from src/app/(auth)/actions.ts. Defaults to the local dev URL if
# unset.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only secret. Never prefix with NEXT_PUBLIC_. Used exclusively by
# src/server/shared/supabase/admin.ts (server-only, landlord-side).
SUPABASE_SERVICE_ROLE_KEY=
